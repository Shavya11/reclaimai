# Razorpay — TEST MODE ONLY. Keys must start with rzp_test_
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# You invent this one; paste the same string into the Razorpay webhook form.
RAZORPAY_WEBHOOK_SECRET=

# Layer 2 runs on either one. Anthropic is used when both are set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Free tier, no card: aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Guardrail #1, the kill switch. false blocks every action. The value here is
# only the default: a flip made through the dashboard is persisted in the
# database and outlives a restart.
AUTOPILOT_ENABLED=true

# Required in the X-Admin-Token header for rule edits, the kill switch and
# resets. Leave empty on a laptop and only this machine may make them; a
# deployment MUST set it, or those endpoints are locked to everyone. The
# dashboard asks for it once per tab - it is never in the bundle.
ADMIN_TOKEN=

# true = log writes instead of calling Razorpay. Keep true until Section 2.
DRY_RUN=true

DATABASE_URL=sqlite:///./data/reclaim.db
TIMEZONE=Asia/Kolkata
