# Razorpay — TEST MODE ONLY. Keys must start with rzp_test_
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# You invent this one; paste the same string into the Razorpay webhook form.
RAZORPAY_WEBHOOK_SECRET=

# Layer 2 runs on either one. Anthropic is used when both are set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Free tier, no card: aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Guardrail #1, the kill switch. false blocks every action.
AUTOPILOT_ENABLED=true

# true = log writes instead of calling Razorpay. Keep true until Section 2.
DRY_RUN=true

DATABASE_URL=sqlite:///./data/reclaim.db
TIMEZONE=Asia/Kolkata
