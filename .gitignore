# secrets — never commit (CLAUDE.md rule 10)
.env
*.key
key_details*.txt

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.hypothesis/

# data
*.db
*.sqlite3
data/*.db

# node / next
node_modules/
.next/

# ui/out is the static export the FastAPI process serves. It is deliberately
# tracked: 780 KB, and committing it means a reviewer can clone and run
# `reclaim serve` without a 364-package npm install or a network connection.

# editors / os
.vscode/
.idea/
.DS_Store
Thumbs.db

# extra secret files
user.env
*.env
!.env.example
.render_key
.deploy_secrets

# rendered demo media — hundreds of MB, regenerate with video/build.py
extras/video/out/
extras/video/clips/
extras/video/voice/
extras/video/stills/
extras/video/__pycache__/

# private working material — reports, review notes, anything not for the repo
private/
*.private.md
