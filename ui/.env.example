# The Render URL of the API, with no trailing slash.
#
# Next.js inlines NEXT_PUBLIC_* at BUILD time, not at runtime — changing this in
# the Vercel dashboard does nothing until you redeploy. That is the single most
# common way this ends up pointing at localhost in production.
#
# Leave it empty for local development: the dashboard then uses relative URLs
# and is served by FastAPI itself on the same origin (`reclaim serve`).
NEXT_PUBLIC_API_BASE=https://reclaimai-api.onrender.com
